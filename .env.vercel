# ============================================
# JIAPI - Vercel Production Environment
# Set these in Vercel Dashboard:
# Project → Settings → Environment Variables
# ============================================

# REQUIRED
SECRET_KEY=your-32-char-secret-key-here-minimum-32-characters-long
DEBUG=false
APP_NAME=JIAPI
APP_VERSION=1.0.0

# Database (SQLite for serverless)
DATABASE_URL=sqlite+aiosqlite:///./jiapi.db

# CORS
BACKEND_CORS_ORIGINS=["https://jiapi.vercel.app","https://*.vercel.app"]

# Frontend API URL
VITE_API_URL=https://jiapi.vercel.app/api/v1

# Optional
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
