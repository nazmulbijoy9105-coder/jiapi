# ============================================
# JIAPI - Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub!
# ============================================

# ============================================
# REQUIRED VARIABLES (Must set for production)
# ============================================

# Application
APP_NAME=JIAPI - Justice & Income API
APP_VERSION=1.0.0
DEBUG=false

# Security - Generate a strong 32+ character secret
# Use: openssl rand -hex 32
SECRET_KEY=your-super-secret-32-char-key-here-change-me

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# DATABASE (SQLite for Vercel serverless)
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./jiapi.db
DATABASE_URL_SYNC=sqlite:///./jiapi.db

# For future PostgreSQL upgrade (Neon, Supabase, etc.)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ============================================
# CORS - Allowed frontend domains
# ============================================
BACKEND_CORS_ORIGINS=["https://jiapi.vercel.app","https://*.vercel.app"]

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_TTL=3600

# Elasticsearch (optional - for advanced search)
# ELASTICSEARCH_URL=http://localhost:9200

# File Upload
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_SIZE=52428800

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Amendment Engine
AMENDMENT_AUTO_APPLY=true
AMENDMENT_NOTIFICATION_WEBHOOK=

# External Sources
NBR_GAZETTE_URL=https://nbr.gov.bd
BDLAWS_URL=http://bdlaws.minlaw.gov.bd

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# FRONTEND ONLY (Vite env vars - prefix with VITE_)
# ============================================
VITE_API_URL=https://jiapi.vercel.app/api/v1
VITE_APP_NAME=JIAPI
